{
  "name": "modern-app",
  "version": "2.0.0",
  "description": "Modern full-stack app: ASP.NET Core 9 backend with SQLite + Angular 21 frontend with CRUD GUI",
  "repository": {
    "type": "git",
    "url": "https://github.com/COG-GTM/angularjs-asp-net48-mvc5"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --project chromium --headed",
    "start:api": "dotnet run --project ModernApp.csproj --urls http://localhost:5000",
    "prettier": "prettier --write \"**/*.{js,json,css,scss,less,md,ts,html}\"",
    "update": "ncu -u",
    "prepare": "npx playwright install"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.30.0",
    "jsdom": "^28.0.0",
    "npm-check-updates": "^16.10.12",
    "prettier": "^2.8.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
